# Copy this template to `.env` before running any deployment or local services.
# Values below are placeholders; replace them with real credentials for your environment.

# Core runtime configuration
ENVIRONMENT=production
DEBUG=false
TEST_MODE=false
ALLOWED_HOSTS=http://localhost:3000,http://localhost:8000
SECRET_KEY=replace-with-long-random-string
PORT=8000
HOST=0.0.0.0

# Database configuration
# Option 1: Full DATABASE_URL (recommended for most cases)
# For local PostgreSQL: postgresql://user:password@localhost:5432/nfl_platform
# For AWS RDS PostgreSQL: postgresql://user:password@your-rds-endpoint.region.rds.amazonaws.com:5432/nfl_platform
# For AWS RDS MySQL: mysql+pymysql://user:password@your-rds-endpoint.region.rds.amazonaws.com:3306/nfl_ai
DATABASE_URL=postgresql://user:password@postgres:5432/nfl_platform

# Option 2: AWS RDS Configuration (alternative to DATABASE_URL)
# These settings will be used if DATABASE_URL is not set or if DB_HOST is provided
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=nfl_platform
DB_ENGINE=postgresql  # postgresql or mysql
DB_USE_SSL=true  # Enable SSL for AWS RDS connections

# Option 3: Legacy MySQL settings (for backward compatibility)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=nfl_user
MYSQL_PASSWORD=nfl_password
MYSQL_DATABASE=nfl_ai

# AWS RDS specific settings
RDS_ENDPOINT=your-rds-endpoint.region.rds.amazonaws.com
RDS_CA_CERT_PATH=/path/to/rds-ca-cert.pem  # Optional: path to RDS CA certificate

# Cache / queue
REDIS_URL=redis://redis:6379/0

# AI providers
OPENAI_API_KEY=replace-with-openai-api-key
VECTOR_DB_URL=https://your-vector-db-endpoint
VECTOR_DB_API_KEY=replace-with-vector-db-api-key

# Optional cloud storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Model storage
MODEL_PATH=models/
TENSORFLOW_MODEL_PATH=models/qb_td_model.keras
TENSORFLOW_SCALER_PATH=models/feature_scaler.pkl
TENSORFLOW_METRICS_PATH=models/training_metrics.json
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
