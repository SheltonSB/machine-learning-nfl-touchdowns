# Copy this file to `.env` and provide environment-specific values.
# Never commit the populated `.env` file to source control.

# ------------------------------------------------------------------------------
# Core service configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
TEST_MODE=false

# API/Backend configuration
PORT=8000
HOST=0.0.0.0
ALLOWED_HOSTS=http://localhost:3000,http://localhost:8000
SECRET_KEY=replace-with-long-random-string

# Database configuration
DATABASE_URL=postgresql://user:password@postgres:5432/nfl_platform
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=nfl_user
MYSQL_PASSWORD=nfl_password
MYSQL_DATABASE=nfl_ai

# Redis configuration
REDIS_URL=redis://redis:6379/0

# Third-party / AI providers
OPENAI_API_KEY=replace-with-openai-api-key
VECTOR_DB_URL=https://your-vector-db-endpoint
VECTOR_DB_API_KEY=replace-with-vector-db-api-key

# AWS / Cloud storage (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Model storage
MODEL_PATH=models/
